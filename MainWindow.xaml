<Window x:Class="PLA_1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PLA_1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <ScrollViewer x:Name="BoardScrollViewer"
              HorizontalScrollBarVisibility="Hidden"
              VerticalScrollBarVisibility="Hidden"
              CanContentScroll="False"
              Background="Transparent"
              SizeChanged="BoardScrollViewer_SizeChanged"
              PreviewMouseWheel="BoardScrollViewer_PreviewMouseWheel"
              PreviewMouseLeftButtonDown="BoardScrollViewer_MouseLeftButtonDown"
              PreviewMouseLeftButtonUp="BoardScrollViewer_MouseLeftButtonUp"
              PreviewMouseMove="BoardScrollViewer_MouseMove"
              LostMouseCapture="BoardScrollViewer_LostMouseCapture">

            <Grid x:Name="BoardContainer">
                <Image x:Name="BoardImage"
               Stretch="None"
               HorizontalAlignment="Left"
               VerticalAlignment="Top"
               RenderOptions.BitmapScalingMode="NearestNeighbor"
               RenderTransformOrigin="0,0">
                    <Image.RenderTransform>
                        <ScaleTransform x:Name="BoardScale"
                                ScaleX="1"
                                ScaleY="1"/>
                    </Image.RenderTransform>
                </Image>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
